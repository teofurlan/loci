{
  "expo": {
    "name": "loci",
    "slug": "loci",
    "scheme": "loci",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#94B0C2",
    "platforms": [
      "android"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.teofurlan.loci",
      "adaptiveIcon": {
        "backgroundColor": "#C9D8E1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "dark": { "backgroundColor": "#000000", "image": "./assets/splash-icon.png" }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Loci uses your location to lay out a course around you and to punch controls during the run.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Loci uses the microphone so you can speak your course request."
        }
      ]
    ]
  }
}
