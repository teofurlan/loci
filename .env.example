# Copy to .env.local and fill in. Never commit real values.
# EXPO_PUBLIC_* values are inlined into the app bundle (a Gemini key ships inside the APK).

# Production: Gemma through the Gemini API. When set, Ollama settings are ignored.
EXPO_PUBLIC_GEMINI_API_KEY=

# Development: local Ollama. The phone reaches the host via `adb reverse tcp:11434 tcp:11434`.
EXPO_PUBLIC_OLLAMA_URL=http://localhost:11434
EXPO_PUBLIC_OLLAMA_MODEL=gemma4:e4b
